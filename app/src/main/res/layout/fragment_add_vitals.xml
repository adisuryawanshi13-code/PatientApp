<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Bar -->
    <RelativeLayout
        android:id="@+id/camp_header"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#FFFFFF"
        android:elevation="4dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btn_back_camp"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="#111827"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Camp Activity"
            android:textColor="#111827"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/stat_sys_upload"
            app:tint="#111827" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/camp_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:paddingBottom="40dp">

            <!-- Vaccination Status -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vaccination Status"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@android:drawable/toast_frame"
                android:backgroundTint="#F1F5F9"
                android:orientation="horizontal"
                android:padding="4dp">
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="None" android:gravity="center" android:textColor="#64748B" android:textSize="14sp"/>
                <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="Partial" android:gravity="center" android:textColor="#64748B" android:textSize="14sp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="Fully"
                    android:gravity="center"
                    android:textColor="#1A56DB"
                    android:textStyle="bold"
                    android:background="@android:drawable/toast_frame"
                    android:backgroundTint="#FFFFFF"
                    android:textSize="14sp"/>
            </LinearLayout>

            <!-- Patient Vitals Inputs -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Patient Vitals"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:columnCount="2"
                android:useDefaultMargins="false">

                <!-- BP Input -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:layout_columnWeight="1">
                    <TextView android:text="BP (mmHg)" android:textColor="#64748B" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/et_bp"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@android:drawable/editbox_background_normal" android:hint="120/80" android:paddingHorizontal="16dp" android:backgroundTint="#F1F5F9" android:textColor="#111827" android:inputType="text"/>
                </LinearLayout>

                <!-- Temp Input -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:layout_columnWeight="1">
                    <TextView android:text="Temp (°C)" android:textColor="#64748B" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/et_temp"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@android:drawable/editbox_background_normal" android:hint="36.5" android:paddingHorizontal="16dp" android:backgroundTint="#F1F5F9" android:textColor="#111827" android:inputType="numberDecimal"/>
                </LinearLayout>

                <!-- Pulse Input -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:padding="4dp" android:layout_columnWeight="1">
                    <TextView android:text="Pulse (BPM)" android:textColor="#64748B" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/et_pulse"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@android:drawable/editbox_background_normal" android:hint="72" android:paddingHorizontal="16dp" android:backgroundTint="#F1F5F9" android:textColor="#111827" android:inputType="number"/>
                </LinearLayout>

                <!-- SPO2 Input -->
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="12dp" android:padding="4dp" android:layout_columnWeight="1">
                    <TextView android:text="SpO2 (%)" android:textColor="#64748B" android:textSize="13sp" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <EditText
                        android:id="@+id/et_spo2"
                        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:background="@android:drawable/editbox_background_normal" android:hint="98" android:paddingHorizontal="16dp" android:backgroundTint="#F1F5F9" android:textColor="#111827" android:inputType="number"/>
                </LinearLayout>
            </GridLayout>

            <!-- Save Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_save_record"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="40dp"
                android:background="@android:drawable/btn_default"
                android:backgroundTint="#EFF6FF"
                android:drawableStart="@android:drawable/ic_menu_save"
                android:drawablePadding="-40dp"
                android:paddingStart="80dp"
                android:text="Save Patient Record"
                android:textAllCaps="false"
                android:textColor="#1A56DB"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- Sync Indicator Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="60dp"
                android:orientation="horizontal">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@android:drawable/presence_online" android:backgroundTint="#10B981"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Data Synchronized (Local: 0 pending)"
                    android:textColor="#64748B"
                    android:textSize="12sp"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>