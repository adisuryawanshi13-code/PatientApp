<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F6FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- TOGGLE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#E9EDF5"
            android:orientation="horizontal"
            android:padding="4dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Weekly"
                android:gravity="center"
                android:textStyle="bold"
                android:textColor="#2962FF"
                android:background="#FFFFFF"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Monthly"
                android:gravity="center"
                android:textColor="#666"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Yearly"
                android:gravity="center"
                android:textColor="#666"/>

        </LinearLayout>



        <!-- HEALTH SCORE CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">


                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:text="CURRENT HEALTH SCORE"
                        android:textSize="13sp"
                        android:textColor="#8A94A6"/>

                    <TextView
                        android:text="85/100"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="#111"/>

                    <TextView
                        android:text="Excellent"
                        android:textColor="#2ECC71"
                        android:textStyle="bold"/>

                </LinearLayout>


                <!-- Circle -->

                <FrameLayout
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/circle_health"/>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_info_details"/>

                </FrameLayout>


            </RelativeLayout>

        </androidx.cardview.widget.CardView>



        <!-- VITALS TREND -->

        <TextView
            android:text="Vitals Trend"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#111"
            android:layout_marginBottom="8dp"/>


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:src="@drawable/vitals_graph"
                android:scaleType="fitXY"/>

        </androidx.cardview.widget.CardView>



        <!-- BLOOD SUGAR TITLE -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">

            <TextView
                android:text="Blood Sugar Levels"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#111"/>

            <TextView
                android:text="mg/dL"
                android:textColor="#8A94A6"
                android:layout_marginStart="8dp"/>

        </LinearLayout>



        <!-- BLOOD SUGAR CARD -->

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="bottom"
                android:padding="16dp"
                android:orientation="horizontal"
                android:weightSum="7">


                <!-- Each bar -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="60dp"
                        android:background="@drawable/bar_blue"/>

                    <TextView
                        android:text="M"
                        android:textSize="12sp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="90dp"
                        android:background="@drawable/bar_blue"/>

                    <TextView
                        android:text="T"
                        android:textSize="12sp"/>

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:gravity="bottom|center"
                    android:orientation="vertical">

                    <View
                        android:layout_width="24dp"
                        android:layout_height="50dp"
                        android:background="@drawable/bar_blue"/>

                    <TextView
                        android:text="W"
                        android:textSize="12sp"/>

                </LinearLayout>


                <!-- Add more days same way -->

            </LinearLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>

</ScrollView>